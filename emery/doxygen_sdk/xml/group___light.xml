      <memberdef kind="function" id="group___light_1gad3a2a9282440927391d925060904a264" prot="public" static="no" const="no" explicit="no" inline="no" virt="non-virtual">
        <type>bool</type>
        <definition>bool light_is_on</definition>
        <argsstring>(void)</argsstring>
        <name>light_is_on</name>
        <param>
          <type>void</type>
        </param>
        <briefdescription>
        </briefdescription>
        <detaileddescription>
<para><simplesect kind="return"><para>true if the backlight is currently on in any form (on, timed, or fading out). Returns false only when the backlight is fully off. Useful for apps that want to behave differently depending on whether the screen is currently lit — e.g. skipping an animation or queuing a visual cue for when the screen wakes. </para>
</simplesect>
</para>
        </detaileddescription>
        <inbodydescription>
        </inbodydescription>
        <location file="build/sdk/emery/include/pebble.h" line="8828" column="6" declfile="build/sdk/emery/include/pebble.h" declline="8828" declcolumn="6"/>
