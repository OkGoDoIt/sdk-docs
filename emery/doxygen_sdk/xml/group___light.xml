        <definition>void light_set_system_color</definition>
        <argsstring>(void)</argsstring>
        <name>light_set_system_color</name>
        <param>
          <type>void</type>
        </param>
        <briefdescription>
<para>Restore the backlight to the user&apos;s default color. Rarely needed — the system resets automatically on app exit. No-op on platforms without a color backlight. </para>
        </briefdescription>
        <detaileddescription>
